// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
//
// Example:
[
  {
    "label": "Package Manager Build Test",
    "command": "zig build test --summary all",
    "args": [],
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "cwd": "$ZED_WORKTREE_ROOT/Shelly.PackageManager",
    "show_command": true,
  },
  {
    "label": "GTK UI Build",
    "command": "./build.sh",
    "args": ["--build-only", "-Doptimize=Debug"],
    "cwd": "$ZED_WORKTREE_ROOT/Shelly.Ui.Gtk",
    "use_new_terminal": false,
    "reveal_target": "dock",
    "allow_concurrent_runs": false,
  },
  {
    // Devario dev build: mirrors build.sh (RLPM-only, devario paths, local Flatpak backend).
    "label": "CLI Build",
    "command": "zig",
    "args": [
      "build",
      "-Doptimize=Debug",
      "-Dlibalpm=false",
      "-Dpath-profile=devario",
      "-Dflatpak-backend-path=$ZED_WORKTREE_ROOT/Shelly.Flatpak.Backend/zig-out/lib/libshelly-flatpak-backend.so.1",
    ],
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "cwd": "$ZED_WORKTREE_ROOT/Shelly.Cli.Zig",
    "show_command": true,
  },
]
