[Desktop Entry]
Name=Shelly
Name[sv]=Shelly
Comment=A Modern Arch Package Manager
Comment[sv]=En modern pakethanterare för Arch Linux
Comment[it]=Un gestore pacchetti moderno per Arch Linux
Comment[ru]=Современный менеджер пакетов для Arch
Comment[pl]=Nowoczesny menedżer pakietów Arch
Exec=/usr/bin/shelly-ui %u
Icon=shelly
Type=Application
Categories=System;Utility;
Keywords=program;software;store;repository;package;add;install;uninstall;remove;update;apps;applications;flatpak;pacman;aur;appimage;
Keywords[sv]=program;software;store;repository;package;add;install;uninstall;remove;update;apps;applications;flatpak;pacman;aur;appimage;programvara;butik;förråd;paket;lägg till;installera;avinstallera;ta bort;uppdatera;appar;program;
Keywords[it]=program;software;store;repository;package;add;install;uninstall;remove;update;apps;applications;flatpak;pacman;aur;appimage;programma;pacchetto;aggiungi;installa;disinstalla;rimuovi;aggiorna;app;applicazioni;
Keywords[ru]=program;software;store;repository;package;add;install;uninstall;remove;update;apps;applications;flatpak;pacman;aur;appimage;программа;приложение;магазин;репозиторий;пакет;добавить;установить;удалить;обновить;приложения;
Keywords[pl]=program;software;store;repository;package;add;install;uninstall;remove;update;apps;applications;flatpak;pacman;aur;appimage;aplikacja;oprogramowanie;sklep;repozytorium;pakiet;dodaj;zainstaluj;odinstaluj;usuń;zaktualizuj;apki;aplikacje;
MimeType=x-scheme-handler/appstream;x-scheme-handler/flatpak+https;application/vnd.flatpak.ref;application/vnd.flatpak;application/x-iso9660-appimage;application/vnd.appimage;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=FlatpakInstall;FlatpakUpdate;FlatpakRemove;

[Desktop Action FlatpakInstall]
Name=Flatpak Install
Name[sv]=Installera Flatpak
Name[it]=Installa Flatpak
Name[ru]=Установить Flatpak
Name[pl]=Zainstaluj Flatpak
Icon=flatpak-symbolic
Exec=/usr/bin/shelly-ui --page flatpak-install

[Desktop Action FlatpakUpdate]
Name=Flatpak Update
Name[sv]=Uppdatera Flatpak
Name[it]=Aggiorna Flatpak
Name[ru]=Обновить Flatpak
Name[pl]=Zaktualizuj Flatpak
Icon=flatpak-symbolic
Exec=/usr/bin/shelly-ui --page flatpak-update

[Desktop Action FlatpakRemove]
Name=Flatpak Remove
Name[sv]=Ta bort Flatpak
Name[it]=Rimuovi Flatpak
Name[ru]=Удалить Flatpak
Name[pl]=Odinstaluj Flatpak
Icon=flatpak-symbolic
Exec=/usr/bin/shelly-ui --page flatpak-remove
