pkgname = shelly
	pkgdesc = Shelly: A Modern Arch Package Manager
	depends = pacman
	depends = gtk4
	depends = glib2
	depends = sudo
	depends = tar
	depends = bash
	depends = git
	depends = hicolor-icon-theme
	depends = dbus
	depends = glibc
	depends = libarchive
	depends = curl
	depends = sqlite
	depends = dconf
	depends = gnupg
	depends = zstd
	depends = json-glib
	optdepends = fish: Fish shell completions
	optdepends = zsh: Zsh shell completions
	optdepends = libstarfish: dependency viewer for arch packages
	optdepends = shelly-flatpak-backend: Flatpak package management support
	optdepends = util-linux: isolate fresh-root provisioning for --isolated builds
