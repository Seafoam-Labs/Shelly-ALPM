pkgbase=shelly
pkgname=(
  'shelly'
  'shelly-cli'
  'shelly-flatpak-backend'
  'shelly-notify'
  'shelly-notify-none'
)
pkgver=3.2.1
pkgrel=2
arch=('x86_64' 'aarch64')
url='https://github.com/Seafoam-Labs/Shelly-ALPM'
license=('GPL-3.0-only')

# Devario uses the RLPM-only native backend and Shelly-owned runtime paths.
# The devario profile also compiles out Arch news, including upgrade-time fetches.
_shelly_libalpm=false
_shelly_path_profile=devario
_shelly_native_depends=()
_shelly_native_optdepends=()

# Vendored libarchive, shipped as a private ICU-free shared library. The
# system libarchive reaches ICU through libxml2, so an ICU soname bump could
# otherwise leave the package manager linked against mismatched libraries in
# the middle of a partial upgrade. Vendoring keeps Shelly's runtime closure
# independent of that chain (aqueous-style self-provided dependency).
_libarchive_ver=3.8.11
_libarchive_so=libarchive-shelly.so.13

makedepends=(
  'acl'
  'binutils'
  'bzip2'
  'cmake'
  'curl'
  'expat'
  'flatpak'
  'gettext'
  'git'
  'go-md2man'
  'gtk4'
  'libb2'
  'lz4'
  'openssl'
  'patch'
  'pax-utils'
  'pkgconf'
  'sqlite'
  'xz'
  'zig>=0.17.1'
  'zlib'
  'zstd'
  "${_shelly_native_depends[@]}"
)
checkdepends=('ripgrep')
_srcdir=Shelly-ALPM
source=(
  "${_srcdir}::git+${url}.git#tag=v${pkgver}"
  "https://github.com/libarchive/libarchive/releases/download/v${_libarchive_ver}/libarchive-${_libarchive_ver}.tar.xz"
  'libarchive-shelly-cmake.patch'
)
sha256sums=(
  'SKIP'
  'a3dc0872b1b39da34dc18ef1b944f0f11ffd37425d70ae04be679279f1cf43d2'
  'd11923427f3b3ad6ecdc61f13c3b789af8799ed3013c2b9266a91ab3aee1439b'
)

# Components with their own build.zig, in build order.
_components=(
  Shelly.Flatpak.Backend
  Shelly.Rlpm
  Shelly.PackageManager
  Shelly.Cli.Zig
  Shelly.Key
  Shelly.Notifications.Zig
  Shelly.Ui.Gtk
)

_zig_build() {
  ZIG_GLOBAL_CACHE_DIR="${srcdir}/zig-global-cache" zig build \
    --cache-dir "${srcdir}/zig-cache" \
    -Dcpu=baseline \
    "$@"
}

_check_arch_news_disabled() {
  local news_help
  if news_help=$("$1" news --help 2>&1); then
    printf 'Devario packages must be built without Arch news. Use sources with the Devario news build policy.\n' >&2
    return 1
  fi
  if [[ $news_help != *'Arch Linux news is unavailable in Devario builds.'* ]]; then
    printf 'Could not verify that Arch news is disabled:\n%s\n' "$news_help" >&2
    return 1
  fi
}

# Keep the libarchive build inside CMake so dependency tracking, shared
# linker flags, and all backend link dependencies follow upstream's target.
# Restrict the supported codecs explicitly; fail instead of silently
# producing a package manager unable to read a usual archive format.
_build_vendored_libarchive() {
  local vendor="${srcdir}/libarchive-vendor"
  local build="${srcdir}/libarchive-build"

  cmake -S "${srcdir}/libarchive-${_libarchive_ver}" -B "${build}" \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON \
    -DENABLE_INSTALL=ON \
    -DENABLE_OPENSSL=ON \
    -DENABLE_MBEDTLS=OFF \
    -DENABLE_NETTLE=OFF \
    -DENABLE_MD=OFF \
    -DENABLE_LIBB2=ON \
    -DENABLE_LZ4=ON \
    -DENABLE_LZMA=ON \
    -DENABLE_ZSTD=ON \
    -DENABLE_ZLIB=ON \
    -DENABLE_BZip2=ON \
    -DENABLE_EXPAT=ON \
    -DENABLE_LIBXML2=OFF \
    -DENABLE_BSDXML=OFF \
    -DENABLE_LZO=OFF \
    -DENABLE_PCREPOSIX=OFF \
    -DENABLE_PCRE2POSIX=OFF \
    -DENABLE_TAR=OFF \
    -DENABLE_CPIO=OFF \
    -DENABLE_CAT=OFF \
    -DENABLE_UNZIP=OFF \
    -DENABLE_TEST=OFF \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_PREFIX="${vendor}"

  # CMake's ENABLE_* switches often mean "use if found", not "require".
  # Enforce the features that the CLI must have in every release build.
  # ENABLE_MD=OFF removes the libmd fallback, so OpenSSL is the only
  # digest backend left and must be present as well. Requiring libb2
  # keeps the bundled BLAKE2 sources (Apache-2.0 OR CC0-1.0 OR OpenSSL)
  # out of the private DSO, so the declared licenses and the libb2
  # runtime dependency stay accurate.
  local feature
  for feature in \
    HAVE_LIBZ HAVE_LIBBZ2 HAVE_LIBLZMA HAVE_LIBLZ4 \
    HAVE_LIBZSTD HAVE_LIBEXPAT HAVE_LIBCRYPTO HAVE_LIBB2; do
    if ! grep -Eq "^#define ${feature}[[:space:]]+1([[:space:]]|$)" \
        "${build}/config.h"; then
      printf 'Vendored libarchive is missing required feature %s\n' "${feature}" >&2
      return 1
    fi
  done

  cmake --build "${build}" --parallel
  cmake --install "${build}"

  # Zig's linkSystemLibrary("archive") probes archive.pc. The shared
  # object already records its own dependencies; do not import the
  # static-only Libs.private field into Shelly's link line.
  cat > "${vendor}/lib/pkgconfig/archive.pc" <<EOF
prefix=${vendor}
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: libarchive
Description: Vendored ICU-free libarchive
Version: ${_libarchive_ver}
Cflags: -I\${includedir}
Libs: -L\${libdir} -larchive-shelly
EOF
}

_use_vendored_libarchive() {
  local vendor="${srcdir}/libarchive-vendor"
  export PKG_CONFIG_PATH="${vendor}/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"
  export CPATH="${vendor}/include${CPATH:+:${CPATH}}"
  export LD_LIBRARY_PATH="${vendor}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
}

prepare() {
  (
    cd "${srcdir}/libarchive-${_libarchive_ver}"
    patch -Np1 -i "${srcdir}/libarchive-shelly-cmake.patch"
  )
  cd "${_srcdir}"

  # Fetch Zig dependencies up front so build() and check() work offline.
  local dir
  for dir in "${_components[@]}"; do
    (cd "${dir}" && _zig_build --fetch)
  done
}

build() {
  cd "${_srcdir}"

  _build_vendored_libarchive
  _use_vendored_libarchive

  (cd Shelly.Flatpak.Backend && _zig_build \
    --prefix "${srcdir}/out-flatpak-backend" \
    -Doptimize=safe)

  (cd Shelly.Cli.Zig && _zig_build \
    --prefix "${srcdir}/out-cli" \
    -Dlibalpm="${_shelly_libalpm}" \
    -Dpath-profile="${_shelly_path_profile}" \
    -Doptimize=small)

  (cd Shelly.Key && _zig_build \
    --prefix "${srcdir}/out-key" \
    -Dpath-profile="${_shelly_path_profile}" \
    -Doptimize=small)

  (cd Shelly.Notifications.Zig && _zig_build \
    --prefix "${srcdir}/out-notify" \
    -Doptimize=small)

  (cd Shelly.Ui.Gtk && _zig_build \
    --prefix "${srcdir}/out-ui" \
    -Dflatpak-backend-package=shelly-flatpak-backend \
    -Doptimize=safe \
    -Daur-backend=atoll)

  # Generate documentation with a fresh configuration, independent of the
  # builder's own Shelly settings.
  (
    set -o pipefail
    export XDG_CONFIG_HOME="${srcdir}/doc-config"
    export XDG_CACHE_HOME="${srcdir}/doc-cache"
    export XDG_DATA_HOME="${srcdir}/doc-data"
    export XDG_STATE_HOME="${srcdir}/doc-state"
    local shelly="${srcdir}/out-cli/bin/shelly" shell
    # Enforce the news policy even when package check() is skipped.
    _check_arch_news_disabled "${shelly}" || return 1
    for shell in bash fish zsh; do
      "${shelly}" utility --completions "${shell}" > "${srcdir}/shelly.${shell}" || return 1
    done
    "${shelly}" utility --docs | go-md2man > "${srcdir}/shelly.1"
  ) || return 1
  sed -i "s|^\\.TH .*|.TH \"SHELLY\" \"1\" \"\" \"Shelly ${pkgver}\" \"Shelly CLI Manual\"|" \
    "${srcdir}/shelly.1"
  printf '\n.SH AUTHORS\nSeafoam Labs.\n' >> "${srcdir}/shelly.1"

  local domain component po
  for domain in shelly-ui:Shelly.Ui.Gtk shelly-notifications:Shelly.Notifications.Zig; do
    component="${domain#*:}"
    domain="${domain%%:*}"
    for po in "${component}"/po/*.po; do
      [[ -f ${po} ]] || continue
      install -d "${srcdir}/locale/$(basename "${po}" .po)/LC_MESSAGES"
      msgfmt "${po}" -o "${srcdir}/locale/$(basename "${po}" .po)/LC_MESSAGES/${domain}.mo"
    done
  done
}

check() {
  cd "${_srcdir}"

  # Test against the same vendored libarchive the shipped CLI will link.
  _use_vendored_libarchive

  # Test the same native backend and path profile as the shipped CLI.
  (cd Shelly.Flatpak.Backend && _zig_build test abi-test integration-test)
  (cd Shelly.PackageManager && _zig_build -Dlibalpm="${_shelly_libalpm}" \
    -Dpath-profile="${_shelly_path_profile}" \
    flatpak-test native-backend-test rlpm-adapter-test bootstrap-test \
    pacfile-test path-profile-test buildinfo-test sandbox-policy-test)
  (cd Shelly.Rlpm && _zig_build test -Dpath-profile="${_shelly_path_profile}")
  (cd Shelly.Key && _zig_build test -Dpath-profile="${_shelly_path_profile}")
  (cd Shelly.Cli.Zig && _zig_build test -Dlibalpm="${_shelly_libalpm}" \
    -Dpath-profile="${_shelly_path_profile}")

  scripts/check-flatpak-separation.sh \
    "${srcdir}/out-cli/bin/shelly" \
    "${srcdir}/out-flatpak-backend/lib/libshelly-flatpak-backend.so.1"
}

package_shelly() {
  pkgdesc='Shelly: A Modern Arch Package Manager (Devario release build)'
  depends=(
    "shelly-cli=${pkgver}-${pkgrel}"
    "shelly-flatpak-backend=${pkgver}-${pkgrel}"
    # Unversioned on purpose: satisfied by shelly-notify or by the
    # shelly-notify-none placeholder, which lets users drop the tray.
    'shelly-notify'
    'glib2'
    'glibc'
    'gtk4'
    'hicolor-icon-theme'
  )
  optdepends=(
    'fuse2: run AppImages that require FUSE 2'
    'libstarfish: dependency viewer for arch packages'
  )
  conflicts=('shelly-git' 'shelly-bin')

  cd "${_srcdir}"

  install -Dm755 "${srcdir}/out-ui/bin/Shelly_Ui_Gtk" "${pkgdir}/usr/bin/shelly-ui"
  install -Dm755 shelly-flatpak-integrate -t "${pkgdir}/usr/bin"
  install -Dm644 com.shellyorg.shelly.desktop -t "${pkgdir}/usr/share/applications"
  install -Dm644 assets/shellylogo.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/shelly.png"

  local mo
  for mo in "${srcdir}"/locale/*/LC_MESSAGES/shelly-ui.mo; do
    [[ -f ${mo} ]] || continue
    install -Dm644 "${mo}" "${pkgdir}/usr/share/locale/${mo#"${srcdir}"/locale/}"
  done
}

package_shelly-cli() {
  pkgdesc='Native Shelly package-manager CLI (Devario release build)'
  # The vendored libarchive is BSD-2-Clause, with BSD-3-Clause parts.
  license=('GPL-3.0-only' 'BSD-2-Clause' 'BSD-3-Clause')
  depends=(
    'acl'
    'bzip2'
    'curl'
    'diffutils'
    'expat'
    'git'
    'glibc'
    'gnupg'
    'libb2'
    'lz4'
    'openssl'
    'sqlite'
    'sudo'
    'tar'
    'xz'
    'zlib'
    'zstd'
    "${_shelly_native_depends[@]}"
  )
  optdepends=(
    "${_shelly_native_optdepends[@]}"
    'devario-devel: build AUR packages and run native isolated builds'
    'desktop-file-utils: update AppImage desktop entries'
    'fuse2: run AppImages that require FUSE 2'
    'gtk-update-icon-cache: update AppImage icons'
    'opendoas: alternative privilege elevator to sudo'
    'plocate: locate-based pacfile discovery'
    'shelly-flatpak-backend: Flatpak package management support'
    'systemd: run isolated build containers with systemd-nspawn'
    'util-linux: isolate fresh-root provisioning for --isolated builds'
    'vim: default visual pacfile diff viewer'
  )
  # The CLI used to ship inside the monolithic shelly packages: shelly up to
  # 3.1.6-1 and shelly-git before the split (3.1.6rNNNN.gHASH versions).
  conflicts=('shelly<3.1.6-2' 'shelly-git<3.1.6.r0' 'shelly-bin' 'shelly-cli-git')
  backup=('etc/shellybuild.conf')

  cd "${_srcdir}"

  install -Dm755 "${srcdir}/out-cli/bin/shelly" -t "${pkgdir}/usr/bin"

  # The vendored ICU-free libarchive that the CLI links against.
  install -Dm755 "${srcdir}/libarchive-vendor/lib/${_libarchive_so}" \
    "${pkgdir}/usr/lib/${_libarchive_so}"
  install -Dm644 "${srcdir}/libarchive-${_libarchive_ver}/COPYING" \
    "${pkgdir}/usr/share/licenses/shelly-cli/libarchive-COPYING"

  # The package metadata must match the compiled native backend variant.
  local dynamic
  dynamic=$(LC_ALL=C readelf -d "${pkgdir}/usr/bin/shelly") || return 1
  if [[ $dynamic != *'Shared library: [libsqlite3.so.0]'* ]]; then
    printf 'Shelly CLI must directly depend on libsqlite3.so.0 (#2059)\n' >&2
    return 1
  fi
  if [[ $dynamic != *"Shared library: [${_libarchive_so}]"* ]]; then
    printf 'Shelly CLI must link the vendored libarchive (%s)\n' "${_libarchive_so}" >&2
    return 1
  fi
  if [[ $dynamic == *'Shared library: [libarchive.so'* ||
        $dynamic == *'Shared library: [libxml2'* ||
        $dynamic == *'Shared library: [libicu'* ]]; then
    printf 'Shelly CLI must not depend on the system libarchive or its ICU chain\n' >&2
    return 1
  fi
  if [[ ${_shelly_libalpm} == true && ${dynamic} != *libalpm.so* ]] ||
     [[ ${_shelly_libalpm} == false && ${dynamic} == *libalpm.so* ]]; then
    printf 'shelly does not match SHELLY_LIBALPM=%s\n' "${_shelly_libalpm}" >&2
    return 1
  fi

  # Check the private DSO separately: a clean CLI DT_NEEDED list does
  # not prove that the library it loads is independent of libxml2/ICU.
  local private
  private=$(LC_ALL=C readelf -d "${pkgdir}/usr/lib/${_libarchive_so}") || return 1
  if [[ $private != *"(SONAME)"*"[${_libarchive_so}]"* ]]; then
    printf 'Vendored libarchive has the wrong SONAME\n' >&2
    return 1
  fi
  if [[ $private == *'Shared library: [libarchive.so'* ||
        $private == *'Shared library: [libxml2.so'* ||
        $private == *'Shared library: [libicu'* ]]; then
    printf 'Vendored libarchive must not depend on system libarchive/libxml2/ICU\n' >&2
    return 1
  fi

  # Resolve every DT_NEEDED edge with the staged private library first.
  # lddtree reads ELF metadata; it does not execute the packaged binary.
  local closure
  closure=$(LD_LIBRARY_PATH="${pkgdir}/usr/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    lddtree -l "${pkgdir}/usr/bin/shelly") || return 1
  # In list mode lddtree prints resolved entries as absolute paths and an
  # unresolved DT_NEEDED entry as a bare soname, still exiting with 0.
  if grep -qv '^/' <<< "${closure}"; then
    printf 'Shelly ELF dependency closure has unresolved entries:\n%s\n' \
      "${closure}" >&2
    return 1
  fi
  if [[ $closure != *"${pkgdir}/usr/lib/${_libarchive_so}"* ]]; then
    printf 'Shelly dependency closure does not resolve the staged private libarchive\n' >&2
    return 1
  fi
  if grep -Eq '(^|/)(libarchive\.so|libxml2\.so|libicu[^/[:space:]]*\.so)' \
      <<< "${closure}"; then
    printf 'Shelly ELF dependency closure still contains libarchive/libxml2/ICU:\n%s\n' \
      "${closure}" >&2
    return 1
  fi

  install -Dm755 "${srcdir}/out-key/bin/shelly-key" -t "${pkgdir}/usr/bin"
  install -Dm644 shellybuild.conf -t "${pkgdir}/etc"

  install -Dm644 "${srcdir}/shelly.bash" "${pkgdir}/usr/share/bash-completion/completions/shelly"
  install -Dm644 "${srcdir}/shelly.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/shelly.fish"
  install -Dm644 "${srcdir}/shelly.zsh" "${pkgdir}/usr/share/zsh/site-functions/_shelly"
  install -Dm644 "${srcdir}/shelly.1" -t "${pkgdir}/usr/share/man/man1"

  # Polkit policy for privileged Shelly CLI execution via pkexec
  install -Dm644 /dev/stdin "${pkgdir}/usr/share/polkit-1/actions/com.shellyorg.shelly.policy" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Shelly</vendor>
  <vendor_url>https://github.com/Seafoam-Labs/Shelly-ALPM</vendor_url>
  <action id="com.shellyorg.shelly.pkexec.cli">
    <description>Run Shelly CLI as administrator</description>
    <message>Run Shelly CLI with administrator privileges.</message>
    <icon_name>shelly</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/shelly</annotate>
  </action>
</policyconfig>
EOF
}

package_shelly-flatpak-backend() {
  pkgdesc='Optional native Flatpak backend for Shelly (Devario release build)'
  depends=("shelly-cli=${pkgver}-${pkgrel}" 'flatpak' 'glib2' 'glibc')
  conflicts=(
    'shelly-flatpak-backend-git'
    'shelly-flatpak-backend-bin'
    'shelly-cli-flatpak-backend-git'
  )
  # Name used by the CLI-only shelly-cli-git packages before the split.
  replaces=('shelly-cli-flatpak-backend-git')

  install -Dm755 "${srcdir}/out-flatpak-backend/lib/libshelly-flatpak-backend.so.1.0.0" \
    -t "${pkgdir}/usr/lib/shelly"
  ln -s libshelly-flatpak-backend.so.1.0.0 \
    "${pkgdir}/usr/lib/shelly/libshelly-flatpak-backend.so.1"
}

package_shelly-notify() {
  pkgdesc='Notification tray for Shelly (Devario release build)'
  depends=("shelly=${pkgver}-${pkgrel}" 'glibc')
  conflicts=('shelly-notify-git')

  cd "${_srcdir}"

  install -Dm755 "${srcdir}/out-notify/bin/shelly-notifications" -t "${pkgdir}/usr/bin"
  install -Dm644 com.shellyorg.shelly-notifications.desktop -t "${pkgdir}/usr/share/applications"

  local icons="${pkgdir}/usr/share/icons/hicolor"
  install -Dm644 assets/shellylogo-tray.png "${icons}/256x256/apps/shelly-tray.png"
  install -Dm644 assets/shellylogo-update.png "${icons}/256x256/apps/shelly-update.png"
  install -Dm644 assets/shelly-updates-symbolic.svg -t "${icons}/symbolic/apps"
  install -Dm644 assets/shelly-shell-symbolic.svg -t "${icons}/symbolic/apps"

  local mo
  for mo in "${srcdir}"/locale/*/LC_MESSAGES/shelly-notifications.mo; do
    [[ -f ${mo} ]] || continue
    install -Dm644 "${mo}" "${pkgdir}/usr/share/locale/${mo#"${srcdir}"/locale/}"
  done
}

package_shelly-notify-none() {
  pkgdesc='Placeholder that satisfies Shelly without the notification tray'
  arch=('any')
  provides=('shelly-notify')
  conflicts=('shelly-notify' 'shelly-notify-git' 'shelly-notify-none-git')
}
