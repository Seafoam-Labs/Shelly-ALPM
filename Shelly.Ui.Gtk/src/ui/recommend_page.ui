<?xml version="1.0" encoding="UTF-8"?>
<interface domain="shelly-ui">
  <requires lib="gtk" version="4.0"/>
  <template class="ShellyRecommendPage" parent="GtkBox">
    <property name="focusable">true</property>
    <property name="focus-on-click">false</property>
    <property name="accessible-role">group</property>
    <accessibility>
      <property name="label" translatable="yes">Recommended</property>
    </accessibility>
    <property name="orientation">vertical</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <child>
      <object class="GtkBox" id="action_bar">
        <property name="orientation">horizontal</property>
        <property name="spacing">8</property>
        <style>
          <class name="toolbar-card"/>
        </style>
        <child>
          <object class="GtkLabel" id="selected_label">
            <property name="label" translatable="yes">0 Selected</property>
            <property name="hexpand">true</property>
            <property name="halign">start</property>
            <style>
              <class name="dim-label"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="clear_button">
            <property name="label" translatable="yes">Clear selection</property>
            <property name="tooltip-text" translatable="yes">Deselect all recommended packages</property>
            <property name="visible">false</property>
            <property name="valign">center</property>
            <signal name="clicked" handler="on_clear_selection_clicked" swapped="true"/>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="refresh_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Refresh the recommended packages list from the network</property>
            <property name="sensitive">false</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
            <signal name="clicked" handler="on_refresh_clicked" swapped="true"/>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="install_selected_button">
            <property name="label" translatable="yes">Install Selected</property>
            <property name="tooltip-text" translatable="yes">Install all selected packages in one transaction</property>
            <property name="sensitive">false</property>
            <property name="valign">center</property>
            <signal name="clicked" handler="on_install_selected_clicked" swapped="true"/>
            <style>
              <class name="suggested-action"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkOverlay" id="page_overlay">
        <property name="vexpand">true</property>
        <child>
          <object class="GtkStack" id="recommend_stack">
            <property name="vexpand">true</property>
            <property name="transition-type">crossfade</property>
            <child>
              <object class="GtkBox" id="loading_page">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkSpinner" id="loading_spinner">
                    <property name="width-request">48</property>
                    <property name="height-request">48</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Loading recommendations…</property>
                    <style>
                      <class name="title-3"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="list_page">
                <property name="overlay-scrolling">false</property>
                <style>
                  <class name="page-body"/>
                </style>
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="GtkBox" id="content_box">
                    <property name="orientation">vertical</property>
                    <property name="spacing">24</property>
                    <property name="margin-start">1</property>
                    <property name="margin-end">1</property>
                    <property name="margin-top">1</property>
                    <property name="margin-bottom">8</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="empty_page">
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkImage">
                    <property name="accessible-role">presentation</property>
                    <property name="icon-name">search-none-symbolic</property>
                    <property name="pixel-size">48</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">No recommendations found</property>
                    <style>
                      <class name="title-3"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Check your internet connection and try again.</property>
                    <property name="wrap">true</property>
                    <property name="justify">center</property>
                    <property name="max-width-chars">40</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
