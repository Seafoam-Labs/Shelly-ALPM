<?xml version="1.0" encoding="UTF-8"?>
<interface domain="shelly-ui">

   <template class="ShellyFlatpakPackageDetail" parent="GtkBox">

    <property name="orientation">vertical</property>
    <property name="hexpand">false</property>
    <property name="width-request">340</property>
    <child>
      <object class="GtkScrolledWindow">
        <property name="hscrollbar-policy">never</property>
        <property name="vscrollbar-policy">automatic</property>
        <property name="propagate-natural-width">false</property>
        <property name="vexpand">true</property>
        <property name="hexpand">false</property>
        <child>
          <object class="GtkBox" id="content_box">
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <property name="halign">fill</property>
            <property name="valign">start</property>
            <property name="margin-top">20</property>
            <property name="margin-bottom">20</property>
            <property name="margin-start">20</property>
            <property name="margin-end">20</property>
            <style><class name="detail-content"/></style>

            <child>
              <object class="GtkLabel" id="name_label">
                <property name="halign">start</property>
                <property name="wrap">true</property>
                <property name="xalign">0</property>
                <style><class name="detail-title"/></style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="summary_label">
                <property name="halign">start</property>
                <property name="wrap">true</property>
                <property name="xalign">0</property>
                <property name="margin-bottom">4</property>
                <style><class name="dim-label"/></style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Information</property>
                <property name="halign">start</property>
                <property name="xalign">0</property>
                <property name="margin-bottom">4</property>
                <style><class name="detail-section-header"/></style>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="spec_box">
                <property name="orientation">vertical</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="about_header">
                <property name="label" translatable="yes">About</property>
                <property name="halign">start</property>
                <property name="xalign">0</property>
                <property name="margin-top">8</property>
                <property name="margin-bottom">4</property>
                <style><class name="detail-section-header"/></style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="about_label">
                <property name="halign">fill</property>
                <property name="wrap">true</property>
                <property name="xalign">0</property>
                <property name="wrap-mode">word-char</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
