<?xml version="1.0" encoding="UTF-8" ?>
<interface domain="shelly-ui">
  <requires lib="gtk" version="4.0"/>
  <template class="ShellyAppImagePage" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <child>
      <object class="GtkOverlay" id="AppImageOverlay">
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkBox" id="AppImagePageMain">
                <property name="orientation">vertical</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="margin-bottom">10</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="halign">fill</property>
                        <property name="margin-bottom">10</property>
                        <property name="margin-top">10</property>
                        <property name="margin-start">10</property>
                        <property name="margin-end">10</property>
                        <property name="spacing">5</property>
                        <child>
                          <object class="GtkSearchEntry" id="AppImageSearchEntry">
                            <property name="placeholder-text" translatable="yes">Search...</property>
                            <property name="width-request">200</property>
                            <property name="valign">center</property>
                            <signal name="search-changed" handler="search_changed" swapped="true"/>
                            <style>
                              <class name="spaced-search"/>
                            </style>
                            <child>
                                <object class="GtkShortcutController">
                                    <property name="scope">managed</property>
                                    <child>
                                        <object class="GtkShortcut">
                                            <property name="trigger">&lt;Control&gt;f</property>
                                            <property name="action">action(search.focus)</property>
                                        </object>
                                    </child>
                                </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="SyncAllButton">
                            <property name="valign">center</property>
                            <property name="tooltip-text" translatable="yes">Sync metadata for all AppImages. Useful if AppImage self updated.</property>
                            <signal name="clicked" handler="sync_all_appimage" swapped="true"/>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">update-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Sync All</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="UpgradeAllButton">
                            <property name="valign">center</property>
                            <property name="tooltip-text" translatable="yes">Upgrade all AppImages to their latest versions</property>
                            <signal name="clicked" handler="upgrade_appimage" swapped="true"/>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">software-update-available-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Upgrade All</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="InstallAppImageButton">
                            <property name="valign">center</property>
                            <property name="tooltip-text" translatable="yes">Install a new AppImage from a file</property>
                            <signal name="clicked" handler="install_appimage" swapped="true"/>
                            <style>
                              <class name="suggested-action"/>
                            </style>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">list-add-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Install AppImage</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="AppImageListWindow">
                        <property name="vexpand">true</property>
                        <property name="hscrollbar-policy">never</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkListBox" id="AppImageListBox">
                                <property name="margin-bottom">1</property>
                                <property name="margin-end">1</property>
                                <property name="margin-start">1</property>
                                <property name="margin-top">1</property>
                                <property name="selection-mode">none</property>
                                <style>
                                  <class name="rich-list"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="DropZone">
                                <property name="orientation">vertical</property>
                                <property name="spacing">25</property>
                                <property name="valign">center</property>
                                <property name="vexpand">true</property>
                                <property name="halign">center</property>
                                <property name="margin-top">40</property>
                                <property name="margin-bottom">40</property>
                                <property name="visible">false</property>
                                <style>
                                  <class name="drop-zone"/>
                                </style>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">document-send-symbolic</property>
                                    <property name="pixel-size">48</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Drop AppImage here to install</property>
                                    <property name="justify">center</property>
                                    <style>
                                      <class name="title-3"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="AppImageDetailView">
                <property name="visible">false</property>
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="halign">center</property>
                    <property name="hexpand">true</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">24</property>
                        <property name="margin-start">20</property>
                        <property name="margin-end">20</property>
                        <property name="margin-top">30</property>
                        <property name="margin-bottom">30</property>
                        <property name="width-request">600</property>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">18</property>
                            <child>
                              <object class="GtkButton" id="BackToListButton">
                                <property name="icon-name">go-previous-symbolic</property>
                                <property name="valign">center</property>
                                <signal name="clicked" handler="back_to_list" swapped="true"/>
                                <style>
                                  <class name="flat"/>
                                  <class name="circular"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkImage" id="DetailIcon">
                                <property name="pixel-size">64</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkLabel" id="DetailTitleLabel">
                                    <property name="label" translatable="yes">App Name</property>
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="title-1"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">8</property>
                                    <child>
                                      <object class="GtkLabel" id="DetailVersionLabel">
                                        <property name="label" translatable="yes">Version</property>
                                        <property name="xalign">0</property>
                                        <style>
                                          <class name="caption"/>
                                          <class name="dim-label"/>
                                        </style>
                                      </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="DetailDescriptionLabel">
                                    <property name="label" translatable="yes">Description goes here...</property>
                                    <property name="xalign">0</property>
                                    <property name="wrap">true</property>
                                    <property name="lines">3</property>
                                    <property name="ellipsize">end</property>
                                    <style>
                                      <class name="body"/>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkListBox">
                            <property name="selection-mode">none</property>
                            <style>
                              <class name="boxed-list"/>
                            </style>
                            <child>
                              <object class="GtkListBoxRow">
                                <child>
                                  <object class="GtkBox">
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Size on Disk</property>
                                        <property name="hexpand">true</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="DetailSizeLabel">
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="dim-label"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <child>
                                  <object class="GtkBox">
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Update Strategy</property>
                                        <property name="hexpand">true</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkDropDown" id="UpdateTypeDropDown">
                                        <property name="valign">center</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <child>
                                  <object class="GtkBox">
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                    <property name="spacing">12</property>
                                    <property name="orientation">vertical</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="yes">Update URL / Repository Info</property>
                                            <property name="xalign">0</property>
                                            <property name="hexpand">true</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLinkButton" id="UpdateUrlInfoButton">
                                            <property name="valign">center</property>
                                            <property name="has-frame">false</property>
                                            <property name="tooltip-text" translatable="yes">Get more information about Update URL / Repository Info</property>
                                            <property name="uri">https://www.seafoam-labs.org/shelly-alpm/docs/appimage/</property>
                                            <child>
                                              <object class="GtkImage">
                                                <property name="icon-name">dialog-information-symbolic</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="UpdateUrlEntry">
                                        <property name="placeholder-text" translatable="yes">e.g. owner/repo or https://...</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="UpdateUrlErrorLabel">
                                        <property name="visible">false</property>
                                        <property name="xalign">0</property>
                                        <property name="label" translatable="yes">Invalid format. Use owner/repo (e.g., seafoam-labs/shelly-alpm)</property>
                                        <style>
                                          <class name="error"/>
                                          <class name="caption"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkCheckButton" id="AllowPrereleaseCheckButton">
                                        <property name="label" translatable="yes">Allow Prerelease</property>
                                        <property name="valign">center</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <child>
                                  <object class="GtkBox">
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                    <property name="spacing">12</property>
                                    <property name="orientation">vertical</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Installation Path</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="InstallPathEntry">
                                        <property name="editable">false</property>
                                        <property name="can-focus">true</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <child>
                                  <object class="GtkBox">
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                    <property name="spacing">12</property>
                                    <property name="orientation">vertical</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Launch Flags</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="LaunchFlagsEntry">
                                        <property name="editable">false</property>
                                        <property name="can-focus">true</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Environment Variables</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">One KEY=value per line. Remove a line to restore the normal environment.</property>
                                        <property name="xalign">0</property>
                                        <property name="wrap">true</property>
                                        <style><class name="dim-label"/></style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkScrolledWindow">
                                        <property name="min-content-height">100</property>
                                        <property name="has-frame">true</property>
                                        <child>
                                          <object class="GtkTextView" id="EnvironmentView">
                                            <property name="monospace">true</property>
                                            <property name="accepts-tab">false</property>
                                            <property name="left-margin">8</property>
                                            <property name="right-margin">8</property>
                                            <property name="top-margin">8</property>
                                            <property name="bottom-margin">8</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="EnvironmentError">
                                        <property name="visible">false</property>
                                        <property name="xalign">0</property>
                                        <property name="wrap">true</property>
                                        <style><class name="error"/></style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="SaveEnvironmentButton">
                                        <property name="label" translatable="yes">Save Environment</property>
                                        <property name="halign">end</property>
                                        <property name="sensitive">false</property>
                                        <signal name="clicked" handler="save_environment" swapped="true"/>
                                      </object>
                                    </child>
                                  </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="halign">center</property>
                            <child>
                              <object class="GtkButton" id="SaveConfigButton">
                                <signal name="clicked" handler="save_config" swapped="true"/>
                                <style>
                                  <class name="suggested-action"/>
                                </style>
                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">8</property>
                                    <property name="halign">center</property>
                                    <property name="valign">center</property>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="icon-name">document-save-symbolic</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Save</property>
                                        <style>
                                          <class name="bold"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="SyncButton">
                                <property name="valign">center</property>
                                <property name="tooltip-text" translatable="yes">Sync metadata for all AppImages. Useful if AppImage self updated.</property>
                                <signal name="clicked" handler="sync_appimage" swapped="true"/>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="suggested-action"/>
                                    </style>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="icon-name">emblem-synchronizing-symbolic</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Sync</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="RemoveAppImageButton">
                                <signal name="clicked" handler="remove_appimage" swapped="true"/>
                                <style>
                                  <class name="destructive-action"/>
                                </style>
                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">8</property>
                                    <property name="halign">center</property>
                                    <property name="valign">center</property>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="icon-name">user-trash-symbolic</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Remove</property>
                                        <style>
                                          <class name="bold"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
