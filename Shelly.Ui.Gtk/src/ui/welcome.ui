<?xml version="1.0" encoding="UTF-8"?>
<interface domain="shelly-ui">
  <requires lib="gtk" version="4.0"/>
  <template class="ShellyWelcomePage" parent="GtkBox">
    <style>
      <class name="welcome-screen"/>
      <class name="welcome-page"/>
    </style>
    <property name="orientation">vertical</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <child>
      <object class="GtkStack" id="welcome_stack">
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <property name="transition-type">slide-left-right</property>
        <child>
          <object class="GtkBox" id="page_welcome">
            <style>
              <class name="welcome-step"/>
            </style>
            <property name="orientation">vertical</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkScrolledWindow">
                <style>
                  <class name="welcome-step-scroll"/>
                </style>
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <child>
                  <object class="GtkBox">
                    <style>
                      <class name="welcome-card"/>
                      <class name="welcome-intro-card"/>
                    </style>
                    <property name="orientation">vertical</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkBox">
                        <style>
                          <class name="welcome-hero"/>
                        </style>
                        <property name="orientation">horizontal</property>
                        <property name="halign">center</property>
                        <child>
                          <object class="GtkImage" id="welcome_image">
                            <style>
                              <class name="welcome-hero-icon"/>
                            </style>
                            <property name="icon-name">shelly</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="welcome_title">
                            <property name="label" translatable="yes">Welcome to Shelly v3</property>
                            <property name="halign">start</property>
                            <property name="valign">center</property>
                            <property name="css-classes">title-1</property>
                            <property name="wrap">true</property>
                            <property name="max-width-chars">40</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="welcome_blurb">
                        <property name="label" translatable="yes">Shelly is a modern package manager for Arch Linux. Configure your sources and preferences to get started.</property>
                        <property name="halign">center</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">50</property>
                        <property name="justify">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSpinner" id="welcome_spinner">
                        <property name="visible">false</property>
                        <property name="halign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="page_sources">
            <style>
              <class name="welcome-step"/>
            </style>
            <property name="orientation">vertical</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkScrolledWindow">
                <style>
                  <class name="welcome-step-scroll"/>
                </style>
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <child>
                  <object class="GtkBox">
                    <style>
                      <class name="welcome-card"/>
                    </style>
                    <property name="orientation">vertical</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Select Your Sources</property>
                        <property name="halign">center</property>
                        <property name="css-classes">title-2</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Choose which package sources you want to browse. You can always change this later in settings.</property>
                        <property name="halign">center</property>
                        <property name="justify">center</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">55</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <style>
                          <class name="welcome-option-list"/>
                        </style>
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="welcome-option-row"/>
                            </style>
                            <child>
                              <object class="GtkCheckButton" id="source_aur"/>
                            </child>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">applications-system-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="hexpand">true</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">AUR</property>
                                    <property name="css-classes">heading</property>
                                    <property name="halign">start</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Arch User Repository community packages</property>
                                    <property name="css-classes">dim-label</property>
                                    <property name="halign">start</property>
                                    <property name="wrap">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="welcome-option-row"/>
                            </style>
                            <child>
                              <object class="GtkCheckButton" id="source_flatpak"/>
                            </child>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">system-run-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="hexpand">true</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Flatpak</property>
                                    <property name="css-classes">heading</property>
                                    <property name="halign">start</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Sandboxed universal Linux applications</property>
                                    <property name="css-classes">dim-label</property>
                                    <property name="halign">start</property>
                                    <property name="wrap">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="welcome-option-row"/>
                            </style>
                            <child>
                              <object class="GtkCheckButton" id="source_appimage"/>
                            </child>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">application-x-executable-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="hexpand">true</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">AppImage</property>
                                    <property name="css-classes">heading</property>
                                    <property name="halign">start</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Portable self-contained application bundles</property>
                                    <property name="css-classes">dim-label</property>
                                    <property name="halign">start</property>
                                    <property name="wrap">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="welcome-option-row"/>
                            </style>
                            <child>
                              <object class="GtkCheckButton" id="source_recommended"/>
                            </child>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">starred-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="hexpand">true</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Recommended</property>
                                    <property name="css-classes">heading</property>
                                    <property name="halign">start</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Curated picks from Shelly</property>
                                    <property name="css-classes">dim-label</property>
                                    <property name="halign">start</property>
                                    <property name="wrap">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="page_appearance">
            <style>
              <class name="welcome-step"/>
            </style>
            <property name="orientation">vertical</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkScrolledWindow">
                <style>
                  <class name="welcome-step-scroll"/>
                </style>
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <child>
                  <object class="GtkBox">
                    <style>
                      <class name="welcome-card"/>
                    </style>
                    <property name="orientation">vertical</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Look and Feel</property>
                        <property name="halign">center</property>
                        <property name="css-classes">title-2</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Customize how Shelly looks and behaves. All of these can be changed later in preferences.</property>
                        <property name="halign">center</property>
                        <property name="justify">center</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">55</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <style>
                          <class name="welcome-option-list"/>
                        </style>
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Navigation Style</property>
                            <property name="halign">start</property>
                            <property name="css-classes">heading</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="welcome-option-row"/>
                            </style>
                            <child>
                              <object class="GtkCheckButton" id="nav_sidebar">
                                <property name="active">true</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">sidebar-show-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="hexpand">true</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Sidebar</property>
                                    <property name="css-classes">heading</property>
                                    <property name="halign">start</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Vertical icon rail on the left</property>
                                    <property name="css-classes">dim-label</property>
                                    <property name="halign">start</property>
                                    <property name="wrap">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="welcome-option-row"/>
                            </style>
                            <child>
                              <object class="GtkCheckButton" id="nav_topbar">
                                <property name="group">nav_sidebar</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">go-top-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="hexpand">true</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Top Bar</property>
                                    <property name="css-classes">heading</property>
                                    <property name="halign">start</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Horizontal tab switcher at the top</property>
                                    <property name="css-classes">dim-label</property>
                                    <property name="halign">start</property>
                                    <property name="wrap">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">System Tray</property>
                            <property name="halign">start</property>
                            <property name="css-classes">heading</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="welcome-option-row"/>
                            </style>
                            <child>
                              <object class="GtkSwitch" id="tray_enabled">
                                <property name="active">true</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Run in system tray when minimized</property>
                                <property name="halign">start</property>
                                <property name="wrap">true</property>
                                <property name="hexpand">true</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="nav_bar">
        <style>
          <class name="welcome-navigation"/>
        </style>
        <property name="hexpand">true</property>
        <property name="valign">end</property>
        <child>
          <object class="GtkButton" id="btn_back">
            <style>
              <class name="welcome-nav-button"/>
              <class name="flat"/>
            </style>
            <property name="label" translatable="yes">Back</property>
            <property name="sensitive">false</property>
            <signal name="clicked" handler="on_back" swapped="true"/>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="hexpand">true</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="btn_next">
            <style>
              <class name="welcome-nav-button"/>
              <class name="suggested-action"/>
            </style>
            <property name="label" translatable="yes">Next</property>
            <signal name="clicked" handler="on_next" swapped="true"/>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="btn_finish">
            <style>
              <class name="welcome-nav-button"/>
              <class name="suggested-action"/>
            </style>
            <property name="visible">false</property>
            <property name="label" translatable="yes">Start Shelly</property>
            <signal name="clicked" handler="on_finish" swapped="true"/>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
