<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="ShellyPackageDetail" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="hexpand">false</property>
    <property name="width-request">340</property>
    <child>
      <object class="GtkScrolledWindow">
        <property name="hscrollbar-policy">never</property>
        <property name="vscrollbar-policy">automatic</property>
        <property name="propagate-natural-width">false</property>
        <property name="vexpand">true</property>
        <property name="hexpand">false</property>
        <child>
          <object class="GtkBox" id="content_box">
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <property name="halign">fill</property>
            <property name="valign">start</property>
            <property name="margin-top">20</property>
            <property name="margin-bottom">20</property>
            <property name="margin-start">20</property>
            <property name="margin-end">20</property>
            <style><class name="detail-content"/></style>

            <!-- Icon -->
            <child>
              <object class="GtkImage" id="icon">
                <property name="pixel-size">64</property>
                <property name="halign">start</property>
                <property name="margin-bottom">8</property>
              </object>
            </child>

            <!-- Name -->
            <child>
              <object class="GtkLabel" id="name_label">
                <property name="halign">start</property>
                <property name="wrap">true</property>
                <property name="xalign">0</property>
                <style><class name="detail-title"/></style>
              </object>
            </child>

            <!-- Description directly under name -->
            <child>
              <object class="GtkLabel" id="description_label">
                <property name="halign">start</property>
                <property name="wrap">true</property>
                <property name="xalign">0</property>
                <property name="margin-bottom">4</property>
                <style><class name="dim-label"/></style>
              </object>
            </child>

            <!-- Subtitle (size) -->
            <child>
              <object class="GtkLabel" id="subtitle_label">
                <property name="halign">start</property>
                <property name="xalign">0</property>
                <property name="margin-bottom">12</property>
                <style><class name="dim-label"/></style>
              </object>
            </child>

            <!-- Information header -->
            <child>
              <object class="GtkLabel">
                <property name="label">Information</property>
                <property name="halign">start</property>
                <property name="xalign">0</property>
                <property name="margin-bottom">4</property>
                <style><class name="detail-section-header"/></style>
              </object>
            </child>

            <!-- Spec rows -->
            <child>
              <object class="GtkBox" id="spec_box">
                <property name="orientation">vertical</property>
              </object>
            </child>

            <!-- Sections (expanders) -->
            <child>
              <object class="GtkBox" id="sections_box">
                <property name="orientation">vertical</property>
                <property name="spacing">8</property>
                <property name="margin-top">12</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
