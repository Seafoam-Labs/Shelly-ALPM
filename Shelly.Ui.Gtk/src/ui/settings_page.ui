                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Installing and removing</property>
                                    <property name="halign">start</property>
                                    <property name="xalign">0</property>
                                    <property name="accessible-role">heading</property>
                                    <accessibility>
                                      <property name="level">3</property>
                                    </accessibility>
                                    <style>
                                      <class name="settings-group-title"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <style>
                                      <class name="settings-card"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">No Confirm</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Skip confirmation prompts when installing, updating, or removing.</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="no_confirm_switch">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">No Confirm</property>
                                              <property name="description" translatable="yes">Skip confirmation prompts when installing, updating, or removing.</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Remove Configuration on Uninstall</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Also delete an app's configuration files when you remove it.</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="remove_cache_switch">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Remove Configuration on Uninstall</property>
                                              <property name="description" translatable="yes">Also delete an app's configuration files when you remove it.</property>
                                            </accessibility>
                                          </object>
                                        </child>
