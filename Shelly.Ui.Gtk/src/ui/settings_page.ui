<?xml version="1.0" encoding="UTF-8"?>
<interface domain="shelly-ui">
  <requires lib="gtk" version="4.0"/>
  <template class="ShellySettingsPage" parent="GtkBox">
    <property name="focusable">true</property>
    <property name="focus-on-click">false</property>
    <property name="accessible-role">group</property>
    <accessibility>
      <property name="label" translatable="yes">Settings</property>
    </accessibility>
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkOverlay" id="page_overlay">
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="margin-start">30</property>
            <property name="margin-end">30</property>
            <property name="margin-top">16</property>
            <property name="margin-bottom">24</property>
            <property name="spacing">16</property>
            <child>
              <object class="GtkStackSwitcher">
                <property name="stack">settings_stack</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkStack" id="settings_stack">
                <property name="transition-type">slide-left-right</property>
                <!-- General page -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">normal_page</property>
                    <property name="title" translatable="yes">General</property>
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vexpand">true</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="hexpand">true</property>
                            <property name="halign">center</property>
                            <property name="width-request">640</property>
                            <property name="spacing">28</property>
                            <style>
                              <class name="settings-page-body"/>
                            </style>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">8</property>
                                <style>
                                  <class name="settings-group"/>
                                </style>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <style>
                                      <class name="settings-card"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Language</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Language for Shelly's menus and messages.</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkDropDown" id="language_drop">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Language</property>
                                              <property name="description" translatable="yes">Language for Shelly's menus and messages.</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">8</property>
                                <style>
                                  <class name="settings-group"/>
                                </style>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Software sources</property>
                                    <property name="halign">start</property>
                                    <property name="xalign">0</property>
                                    <property name="accessible-role">heading</property>
                                    <accessibility>
                                      <property name="level">3</property>
                                    </accessibility>
                                    <style>
                                      <class name="settings-group-title"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Choose which kinds of software Shelly shows. You can change this at any time.</property>
                                    <property name="halign">start</property>
                                    <property name="xalign">0</property>
                                    <property name="wrap">true</property>
                                    <style>
                                      <class name="settings-group-description"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <style>
                                      <class name="settings-card"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkImage" id="aur_row_icon">
                                            <property name="icon-name">arch-symbolic</property>
                                            <property name="pixel-size">20</property>
                                            <property name="valign">center</property>
                                            <property name="accessible-role">presentation</property>
                                            <style>
                                              <class name="settings-row-icon"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel" id="aur_row_label">
                                                <property name="label" translatable="yes">Enable AUR</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="aur_row_subtitle">
                                                <property name="label" translatable="yes">Arch User Repository community packages</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="aur_switch">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Enable AUR</property>
                                              <property name="description" translatable="yes">Arch User Repository community packages</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">flatpak-symbolic</property>
                                            <property name="pixel-size">20</property>
                                            <property name="valign">center</property>
                                            <property name="accessible-role">presentation</property>
                                            <style>
                                              <class name="settings-row-icon"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Enable Flatpak</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Sandboxed universal Linux applications</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="flatpak_switch">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Enable Flatpak</property>
                                              <property name="description" translatable="yes">Sandboxed universal Linux applications</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">application-x-executable-symbolic</property>
                                            <property name="pixel-size">20</property>
                                            <property name="valign">center</property>
                                            <property name="accessible-role">presentation</property>
                                            <style>
                                              <class name="settings-row-icon"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Enable AppImage</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Portable self-contained application bundles</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="appimage_switch">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Enable AppImage</property>
                                              <property name="description" translatable="yes">Portable self-contained application bundles</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">firmware-symbolic</property>
                                            <property name="pixel-size">20</property>
                                            <property name="valign">center</property>
                                            <property name="accessible-role">presentation</property>
                                            <style>
                                              <class name="settings-row-icon"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Enable Firmware</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Update device firmware such as UEFI/BIOS and peripherals</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="fwupd_switch">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Enable Firmware</property>
                                              <property name="description" translatable="yes">Update device firmware such as UEFI/BIOS and peripherals</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">star-filled-rounded-symbolic</property>
                                            <property name="pixel-size">20</property>
                                            <property name="valign">center</property>
                                            <property name="accessible-role">presentation</property>
                                            <style>
                                              <class name="settings-row-icon"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Enable Recommended</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Curated picks from Shelly</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="recommended_switch">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Enable Recommended</property>
                                              <property name="description" translatable="yes">Curated picks from Shelly</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <!-- Updates page -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">updates_page</property>
                    <property name="title" translatable="yes">Updates &amp; Tray</property>
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vexpand">true</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="hexpand">true</property>
                            <property name="halign">center</property>
                            <property name="width-request">640</property>
                            <property name="spacing">28</property>
                            <style>
                              <class name="settings-page-body"/>
                            </style>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">8</property>
                                <style>
                                  <class name="settings-group"/>
                                </style>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Update notifications</property>
                                    <property name="halign">start</property>
                                    <property name="xalign">0</property>
                                    <property name="accessible-role">heading</property>
                                    <accessibility>
                                      <property name="level">3</property>
                                    </accessibility>
                                    <style>
                                      <class name="settings-group-title"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Shelly can check for updates in the background and let you know from the system tray.</property>
                                    <property name="halign">start</property>
                                    <property name="xalign">0</property>
                                    <property name="wrap">true</property>
                                    <style>
                                      <class name="settings-group-description"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <style>
                                      <class name="settings-card"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Enable Tray Icon</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Show a tray icon that checks for updates in the background.</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="tray_switch">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Enable Tray Icon</property>
                                              <property name="description" translatable="yes">Show a tray icon that checks for updates in the background.</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="tray_auto_switch_box">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Add Tray To Auto Start</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Start the tray icon when you log in.</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="tray_auto_switch">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Add Tray To Auto Start</property>
                                              <property name="description" translatable="yes">Start the tray icon when you log in.</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="tray_interval_box">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Tray Check Interval (Hours)</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">How often the tray looks for updates.</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSpinButton" id="tray_interval_spin">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <property name="adjustment">
                                              <object class="GtkAdjustment">
                                                <property name="lower">1</property>
                                                <property name="upper">96</property>
                                                <property name="step-increment">1</property>
                                                <property name="value">12</property>
                                              </object>
                                            </property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Tray Check Interval (Hours)</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="weekly_schedule_switch_box">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Use weekly schedule</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
