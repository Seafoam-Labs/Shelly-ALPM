                                          <object class="GtkSwitch" id="shelly_search_switch">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Enable Shelly Search</property>
                                              <property name="description" translatable="yes">Add a page that searches every source at once.</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Enable Atoll Powered AUR</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Browse the AUR through Seafoam Labs' Atoll service.</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="atoll_aur_switch">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Enable Atoll Powered AUR</property>
                                              <property name="description" translatable="yes">Browse the AUR through Seafoam Labs' Atoll service.</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">8</property>
                                <style>
                                  <class name="settings-group"/>
                                </style>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">AppImage</property>
                                    <property name="halign">start</property>
                                    <property name="xalign">0</property>
                                    <property name="accessible-role">heading</property>
                                    <accessibility>
                                      <property name="level">3</property>
                                    </accessibility>
                                    <style>
                                      <class name="settings-group-title"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <style>
                                      <class name="settings-card"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Always Recheck AppImage Updates on Upgrade All</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">When off, Upgrade All runs only when the AppImage page shows updates.</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="appimage_upgrade_all_recheck_switch">
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Always Recheck AppImage Updates on Upgrade All</property>
                                              <property name="description" translatable="yes">When off, Upgrade All runs only when the AppImage page shows updates.</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="appimage_install_path_box">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">16</property>
                                        <style>
                                          <class name="settings-form-row"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">AppImage Install Path</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Folder where new AppImages are saved.</property>
                                                <property name="halign">start</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                                <style>
                                                  <class name="settings-row-subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="appimage_install_path_button">
                                            <property name="label" translatable="yes">Select Directory</property>
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <!-- Bottom action bar -->
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">10</property>
                <style>
                  <class name="settings-footer"/>
                </style>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">10</property>
                    <property name="hexpand">true</property>
                    <property name="halign">start</property>
                    <child>
                      <object class="GtkLabel" id="version_label">
                        <property name="margin-start">20</property>
                        <property name="margin-end">20</property>
                        <property name="label" translatable="yes">v0.0.0</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLinkButton" id="github_link">
                        <property name="label" translatable="yes">GitHub</property>
                        <property name="uri">https://github.com/Seafoam-Labs/Shelly-ALPM</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLinkButton" id="fluxer_link">
                        <property name="label" translatable="yes">Community fluxer</property>
                        <property name="uri">https://fluxer.gg/vOjrMXcE</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLinkButton" id="sponsor_link">
                        <property name="label" translatable="yes">Sponsor</property>
                        <property name="uri">https://www.patreon.com/cw/SeafoamLabs</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="changelog_button">
                    <property name="label" translatable="yes">View Changelog</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="save_button">
                    <property name="label" translatable="yes">Save</property>
                    <property name="halign">end</property>
                    <style>
                      <class name="suggested-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
  <object class="GtkSizeGroup">
    <property name="mode">horizontal</property>
    <widgets>
      <widget name="default_page_drop"/>
      <widget name="nav_mode_drop"/>
      <widget name="theme_mode_drop"/>
      <widget name="theme_variant_drop"/>
    </widgets>
  </object>
</interface>
