<?xml version="1.0" encoding="UTF-8"?>
<interface domain="shelly-ui">
  <requires lib="gtk" version="4.0"/>
  <template class="ShellyFlatpakPage" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <style><class name="flatpak-page"/></style>
    <child>
      <object class="GtkBox">
        <property name="orientation">horizontal</property>
        <property name="vexpand">true</property>
        <property name="hexpand">true</property>
          <property name="margin-start">2</property>
        <property name="margin-end">9</property>
        <property name="margin-bottom">9</property>
        <child>
          <object class="GtkFrame">
            <property name="margin-end">5</property>
            <property name="margin-top">5</property>
            <style><class name="form-surface"/></style>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">5</property>
                <property name="margin-start">5</property>
                <property name="margin-end">5</property>
                <property name="margin-top">5</property>
                <property name="margin-bottom">5</property>
                <property name="hexpand">false</property>
                <property name="width-request">120</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">5</property>
                    <property name="margin-bottom">4</property>
                    <child>
                      <object class="GtkSearchEntry" id="search_entry">
                        <property name="placeholder-text" translatable="yes">Search packages...</property>
                        <property name="hexpand">true</property>
                        <style>
                          <class name="spaced-search"/>
                          <class name="compact-search-entry"/>
                          <class name="flatpak-sidebar-search"/>
                        </style>
                        <child>
                            <object class="GtkShortcutController">
                                <property name="scope">managed</property>
                                <child>
                                    <object class="GtkShortcut">
                                        <property name="trigger">&lt;Control&gt;f</property>
                                        <property name="action">action(search.focus)</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Browse</property>
                    <property name="halign">start</property>
                    <property name="margin-start">6</property>

                    <style>
                      <class name="dim-label"/>
                      <class name="caption-heading"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkListBox" id="section_nav_list">
                    <style>
                      <class name="flatpak-nav"/>
                    </style>
                    <property name="selection-mode">single</property>
                    <property name="width-request">160</property>

                    <child>
                      <object class="GtkListBoxRow" id="nav_install_row">

                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">10</property>
                            <property name="margin-start">6</property>
                            <property name="margin-top">2</property>
                            <property name="margin-bottom">2</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">system-software-install-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Install</property>
                                <property name="halign">start</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow" id="nav_remove_row">

                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">10</property>
                            <property name="margin-start">6</property>
                            <property name="margin-top">2</property>
                            <property name="margin-bottom">2</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">applications-system-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Manage</property>
                                <property name="halign">start</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow" id="nav_remote_row">
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">10</property>
                            <property name="margin-start">6</property>
                            <property name="margin-top">2</property>
                            <property name="margin-bottom">2</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">preferences-system-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Manage Remote Refs</property>
                                <property name="halign">start</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBoxRow" id="nav_install_local">
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">10</property>
                            <property name="margin-start">6</property>
                            <property name="margin-top">2</property>
                            <property name="margin-bottom">2</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">document-open-symbolic</property>
                                <property name="pixel-size">16</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Install Local</property>
                                <property name="halign">start</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="category_sidebar_scroll">
                    <property name="overlay-scrolling">true</property>
                    <property name="vexpand">true</property>
                    <property name="hscrollbar-policy">never</property>
                    <property name="has-frame">false</property>
                    <property name="width-request">160</property>
                    <child>
                      <object class="GtkListBox" id="category_list">
                        <style>
                          <class name="flatpak-nav"/>
                          <class name="flatpak-category-list"/>
                        </style>
                        <property name="selection-mode">single</property>
                        <property name="width-request">160</property>
                        <property name="vexpand">true</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkFrame">
            <property name="margin-top">5</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <style><class name="package-results"/></style>
            <child>
              <object class="GtkStack" id="main_content_stack">
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <property name="margin-start">5</property>
                <property name="margin-end">5</property>
                <property name="margin-top">5</property>
                <property name="margin-bottom">5</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
